# =============================================================================
# Boréal Marché — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Secrets must NEVER be committed to Git.
# =============================================================================

# --- OpenAI (optional — only needed for Head C OpenAI provider) ---
# Leave empty unless you have a key; the API then reports the provider as unavailable.
OPENAI_API_KEY=

# --- Ollama (optional — only needed for Head C local LLM provider) ---
# Compose overrides OLLAMA_HOST with its own Ollama service (http://ollama:11434).
OLLAMA_HOST=http://localhost:11434
# Model the API asks Ollama for, and the one Compose pulls; default = configs/pipeline.yaml.
OLLAMA_MODEL=llama3.2:3b

# --- Prediction-log database ---
# Outside Docker the API defaults to sqlite:///<repo>/data/logs/predictions.db.
# Compose sets DATABASE_URL to its PostgreSQL service, using this password.
# DATABASE_URL=postgresql+psycopg://boreal:<password>@localhost:5432/boreal
POSTGRES_PASSWORD=boreal-local-only

# --- MLflow tracking and model registry ---
# Training and the registry default to sqlite:///absolute/project/path/mlflow.db.
# Set this only when using a separately running tracking server:
# MLFLOW_TRACKING_URI=http://localhost:5000
# The API serves the registry's champion and falls back to artifacts/ (see /version).
# MODEL_SOURCE=local skips the registry entirely.
# MODEL_SOURCE=registry

# --- Monitoring alerts ---
# The API checks its monitoring rules in the background and alerts on any breach.
# Alerts always go to the log and the alert_log table; set a webhook URL (for example a
# Slack or Teams incoming webhook) to also receive them there. It is a secret: never commit it.
# ALERT_WEBHOOK_URL=
# Seconds between evaluations (default 60, configs/pipeline.yaml).
# ALERT_INTERVAL_SECONDS=60

# --- SageMaker (scripts/sagemaker_jobs.py; see docs/SAGEMAKER.md) ---
# SAGEMAKER_ROLE_ARN=arn:aws:iam::<account>:role/<sagemaker-execution-role>
# SAGEMAKER_IMAGE_URI=<account>.dkr.ecr.ca-central-1.amazonaws.com/boreal-marche-sagemaker:<tag>
# SAGEMAKER_BUCKET=<your-bucket-in-ca-central-1>

# --- AWS (for CD pipeline — set via OIDC in CI, not stored here) ---
# AWS_REGION=ca-central-1
# AWS_ACCOUNT_ID=123456789012
# ECR_REPOSITORY=boreal-marche

# --- Application ---
# production = JSON log lines; the Docker image and Compose always use production.
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# --- Docker Compose host settings ---
# `make up` passes this file to Compose; a plain `docker compose` call reads your shell.
# Host ports (change them if 8000/8501/5000 are already taken):
API_PORT=8000
STREAMLIT_PORT=8501
MLFLOW_PORT=5000
# Bind-mount ownership on Linux: set both to the output of `id -u` and `id -g`.
# LOCAL_UID=1000
# LOCAL_GID=1000
