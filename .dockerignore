# Version control
.git
.gitignore

# Python
__pycache__
*.py[cod]
*.egg-info
dist
build
.eggs

# Virtual environments
.venv
venv
env

# Data (tracked by DVC, not shipped in image)
data/raw/
*.xlsx

# MLflow local runs
mlruns/
mlartifacts/
mlflow.db*
outputs/
deliverables/
node_modules/
data/model_cache/
data/chromadb/
data/processed/
data/logs/
reports/**
!reports/current_run/
reports/current_run/**
!reports/current_run/retention_metrics.json
!reports/current_run/retention_diagnostics.json
!reports/current_run/recommendation_metrics.json
!reports/current_run/rules_scaling.json
!reports/current_run/figures/
reports/current_run/figures/**
!reports/current_run/figures/precision_recall_curve.png
!reports/current_run/figures/roc_curve.png
!reports/current_run/figures/reliability_curve.png
# Evaluation output from training (per-customer test scores); the API never reads it
artifacts/test_predictions.parquet

# IDE
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Docker (the Dockerfile is read separately; only the SageMaker stage's pip list is copied)
docker/
!docker/sagemaker-requirements.txt
!docker/gcp-requirements.txt
.dockerignore

# CI/CD
.github/

# Tests (not needed in production image)
tests/

# Notebooks (development only)
notebooks/

# Documentation sources, except what the images use: the assistant's corpus, and the
# documents the interface's About tab renders (model card, data card, architecture, notices).
*.md
!governance/*.md
!docs/corpus/*.md
!MODEL_CARD.md
!DATA_CARD.md
!ARCHITECTURE.md

# Environment files
.env
.env.*

# DVC
.dvc/
*.dvc
