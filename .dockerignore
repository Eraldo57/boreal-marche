# Version control
.git
.gitignore

# Python
__pycache__
*.py[cod]
*.egg-info
dist
build
.eggs

# Virtual environments
.venv
venv
env

# Data (tracked by DVC, not shipped in image)
data/raw/
*.xlsx

# MLflow local runs
mlruns/
mlartifacts/
mlflow.db*
outputs/
node_modules/
data/model_cache/
data/chromadb/
data/processed/
data/logs/
reports/
# Evaluation output from training (per-customer test scores); the API never reads it
artifacts/test_predictions.parquet

# IDE
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Docker (the Dockerfile is read separately; the build context never needs it)
docker/
.dockerignore

# CI/CD
.github/

# Tests (not needed in production image)
tests/

# Notebooks (development only)
notebooks/

# Documentation sources, except what the images use: the assistant's corpus, and the
# documents the interface's About tab renders (model card, data card, architecture, notices).
*.md
!governance/*.md
!docs/corpus/*.md
!MODEL_CARD.md
!DATA_CARD.md
!ARCHITECTURE.md

# Environment files
.env
.env.*

# DVC
.dvc/
*.dvc
